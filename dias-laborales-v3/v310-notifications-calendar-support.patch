+
+test('si el aviso de mañana venció hace pocos segundos, lo recupera en vez de descartarlo', () => {
+  const state = baseState({
+    startDate: '2027-01-02',
+    schemeSegments: [{ from: '2027-01-02', anchorIsWork: true }],
+    notifications: { enabled: true, hour: 22, minute: 0, horizonDays: 30 }
+  });
+  const now = new Date(2027, 0, 1, 22, 0, 20, 0);
+  const plan = buildWorkNotificationPlan(state, now);
+  const alert = plan.find(item => item.extra.dateKey === '2027-01-02');
+  assert.ok(alert);
+  assert.equal(alert.extra.lateRecovery, true);
+  assert.equal(alert.schedule.at.getTime(), now.getTime() + 5_000);
+});
+
+test('un aviso vencido hace más de quince minutos no se recupera', () => {
+  const state = baseState({
+    startDate: '2027-01-02',
+    schemeSegments: [{ from: '2027-01-02', anchorIsWork: true }],
+    notifications: { enabled: true, hour: 22, minute: 0, horizonDays: 30 }
+  });
+  const now = new Date(2027, 0, 1, 22, 16, 0, 0);
+  const plan = buildWorkNotificationPlan(state, now);
+  assert.equal(plan.some(item => item.extra.dateKey === '2027-01-02'), false);
+});
