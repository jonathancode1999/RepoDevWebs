diff --git a/src/styles/app.css b/src/styles/app.css
index 75ae020..69a9647 100644
--- a/src/styles/app.css
+++ b/src/styles/app.css
@@ -418,3 +418,30 @@ body.theme-light .home-calendar-block .compact-calendar .calendar-day.work .day-
 .support-dialog .dialog-card { max-width: 380px; }
 .support-info-box { display: flex; flex-direction: column; gap: 4px; margin: 14px 0; padding: 12px 14px; border-radius: 14px; background: color-mix(in srgb, var(--accent) 8%, var(--surface)); border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line)); }
 .support-info-box span { color: var(--text-muted); font-size: .75rem; line-height: 1.45; }
+
+
+/* Accesos visibles en Inicio, Calendario y Ajustes */
+.project-strip {
+  position: sticky; top: calc(64px + var(--safe-top)); z-index: 19;
+  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
+  width: min(100%, 620px); margin: 0 auto; padding: 8px 18px;
+  border-bottom: 1px solid var(--line-soft);
+  background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(14px);
+}
+.project-chip {
+  min-width: 0; min-height: 46px; display: grid; grid-template-columns: 24px 1fr; align-items: center; gap: 8px;
+  padding: 7px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--text); text-align: left;
+}
+.project-chip svg { width: 21px; height: 21px; fill: none; stroke: var(--sky); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
+.project-chip span { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
+.project-chip strong { font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.project-chip small { color: var(--muted); font-size: .57rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.project-chip.support-chip { border-color: color-mix(in srgb, var(--blue) 46%, var(--line)); }
+.project-chip.support-chip svg { stroke: #f17793; }
+@media (max-width: 390px) {
+  .project-strip { padding-inline: 12px; gap: 6px; }
+  .project-chip { grid-template-columns: 20px 1fr; gap: 6px; padding-inline: 8px; }
+  .project-chip svg { width: 19px; height: 19px; }
+  .project-chip strong { font-size: .66rem; }
+  .project-chip small { font-size: .53rem; }
+}
