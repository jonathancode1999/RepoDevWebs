+export async function cleanupLegacyWorkNotifications() {
+  if (!isNativeAndroid()) return 0;
+  const LocalNotifications = await getLocalNotifications();
+  if (!LocalNotifications) return 0;
+  try {
+    const pending = await LocalNotifications.getPending();
+    const legacyWork = (pending.notifications || []).filter(item => item?.extra?.type === 'work');
+    if (legacyWork.length) {
+      await LocalNotifications.cancel({ notifications: legacyWork.map(item => ({ id: item.id })) });
+      console.info(`Avisos de turno antiguos eliminados: ${legacyWork.length}`);
+    }
+    return legacyWork.length;
+  } catch (error) {
+    console.error('No se pudieron limpiar avisos de turno antiguos:', error);
+    return 0;
+  }
+}
