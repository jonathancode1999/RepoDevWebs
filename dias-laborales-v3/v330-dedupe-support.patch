+    private static boolean wasFiredRecently(Context context, int id, long now) {
+        JSONObject fired = getFired(context);
+        pruneFired(fired, now);
+        long at = fired.optLong(String.valueOf(id), 0L);
+        prefs(context).edit().putString(KEY_FIRED, fired.toString()).apply();
+        return at > 0L && now - at <= FIRED_KEEP_MS;
+    }
+
+    private static void pruneFired(JSONObject fired, long now) {
+        JSONArray names = fired.names();
+        if (names == null) return;
+        for (int i = 0; i < names.length(); i++) {
+            String key = names.optString(i, "");
+            long at = fired.optLong(key, 0L);
+            if (at <= 0L || now - at > FIRED_KEEP_MS) fired.remove(key);
+        }
     }
 
